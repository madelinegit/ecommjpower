<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>James Power | Carpenter, Handyman & Home Services – North Lake Tahoe, Truckee, Tahoe City</title>
  <meta name="description" content="James Power – licensed carpenter, painter, handyman, and home improvement specialist serving North Lake Tahoe, Truckee, Tahoe City, Kings Beach, Carnelian Bay, Tahoe Vista, Northstar, Olympic Valley, Homewood, Tahoe Donner, and Martis Camp. Deck repairs, bathroom updates, property maintenance, snow removal. Call 772-341-8850." />
  <meta name="keywords" content="carpenter North Lake Tahoe, handyman Truckee, painter Tahoe City, deck repair Kings Beach, snow removal Tahoe Donner, bathroom remodel Northstar, property maintenance Carnelian Bay, home improvement Tahoe Vista, handyman Martis Camp, contractor Olympic Valley, home services Homewood, carpenter Carnelian Bay, Power Creations LLC, James Power construction, deck repairs Lake Tahoe, bathroom updates Truckee, property maintenance North Lake Tahoe" />
  <meta name="robots" content="index, follow" />
  <meta property="og:title" content="James Power | Carpenter & Home Services – North Lake Tahoe" />
  <meta property="og:description" content="Carpenter, painter, handyman, deck repairs, bathroom updates, property maintenance & snow removal. Serving Truckee, Tahoe City, Kings Beach, Northstar, and all of North Lake Tahoe." />
  <meta property="og:type" content="website" />
  <meta name="geo.region" content="US-CA" />
  <meta name="geo.placename" content="North Lake Tahoe, California" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate icon" href="/logo.png" type="image/png" />
  <link rel="stylesheet" href="/styles.css" />
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Power Creations LLC",
    "alternateName": "James Power Construction",
    "description": "Carpenter, painter, handyman, deck repairs, bathroom updates, property maintenance, snow removal, and home improvement specialist serving North Lake Tahoe and surrounding communities.",
    "telephone": "+17723418850",
    "email": "jpowertahoe@aol.com",
    "url": "",
    "sameAs": ["https://www.instagram.com/jpowercreations"],
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "North Lake Tahoe",
      "addressRegion": "CA",
      "addressCountry": "US"
    },
    "areaServed": [
      "North Lake Tahoe", "Truckee", "Tahoe City", "Carnelian Bay",
      "Tahoe Vista", "Kings Beach", "Martis Camp", "Northstar",
      "Olympic Valley", "Homewood", "Tahoe Donner", "Reno"
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Home Services",
      "itemListElement": [
        {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Carpentry"}},
        {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Painting"}},
        {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Handyman Services"}},
        {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Snow Removal"}},
        {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Deck Repairs"}},
        {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Bathroom Updates"}},
        {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Property Maintenance"}},
        {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Home Improvement"}}
      ]
    }
  }
  </script>
</head>
<body>

  <!-- VIEW TOGGLE -->
  <nav class="view-nav" role="tablist" aria-label="Choose which business to view">
    <button class="view-btn active" data-view="art" role="tab" aria-selected="true">
      <svg class="view-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10.5 2.5h3"/>
        <path d="M12 2.5v2"/>
        <path d="M8.6 4.5h6.8l1.6 3.2v11.3a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V7.7z"/>
        <path d="M7 8h10"/>
        <path d="M12 8v12"/>
      </svg>
      <span class="view-btn-text">
        <span class="view-btn-title">Art Gallery</span>
        <span class="view-btn-sub">Handcrafted goods</span>
      </span>
    </button>
    <button class="view-btn" data-view="home" role="tab" aria-selected="false">
      <svg class="view-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
      <span class="view-btn-text">
        <span class="view-btn-title">Home Projects</span>
        <span class="view-btn-sub">Repairs &amp; services</span>
      </span>
    </button>
  </nav>

  <!-- ===== VIEW 1: ART GALLERY ===== -->
  <section id="tab-art" class="tab-content active">

    <header class="hero">
      <div class="hero-badge">
        <img src="/logo.png" alt="JPC Logo" class="hero-logo" />
      </div>
      <h1 class="hero-title">James Power<br><span>Creations</span></h1>
      <p class="hero-sub">Handcrafted Woodworking &amp; Artisan Goods &mdash; Made in Tahoe, Shipped Anywhere</p>
      <p class="hero-location">Power Creations LLC &mdash; North Lake Tahoe &amp; Truckee, CA</p>
    </header>

    <!-- FEATURED PIECE -->
    <% if (featured.art) { %>
    <section class="featured">
      <div class="featured-badge">Featured Piece</div>
      <div class="lantern-showcase">
        <div class="lantern-img-wrap">
          <a href="/piece/<%= featured.art.id %>/<%= slug(featured.art.title) %>">
            <img src="<%= featured.art.images[0].url %>" alt="<%= featured.art.title %>" class="lantern-photo" />
          </a>
        </div>
        <div class="lantern-info">
          <h2><%= featured.art.title %></h2>
          <% if (featured.art.description) { %><p><%= featured.art.description %></p><% } %>
          <% if (featured.art.price) { %><p class="piece-price"><%= featured.art.price %></p><% } %>
          <a href="<%- smsLink(featured.art) %>" class="btn-primary">Ask about this piece</a>
        </div>
      </div>
    </section>
    <% } else { %>
    <!-- FEATURED PRODUCT -->
    <section class="featured">
      <div class="featured-badge">Featured Product</div>
      <div class="lantern-showcase">
        <div class="lantern-img-wrap">
          <img src="/lantern.jpg" alt="Handcrafted Stained Glass Lantern" class="lantern-photo" />
        </div>
        <div class="lantern-info">
          <h2>Stained Glass Lanterns</h2>
          <p>Each lantern is hand-built with locally sourced hardwood and individually cut stained glass panels. No two are alike — every piece carries the grain, color, and character of the wood it came from.</p>
          <ul class="lantern-features">
            <li>Solid hardwood frame</li>
            <li>Hand-cut art glass panels</li>
            <li>Custom sizes available</li>
            <li>Indoor &amp; outdoor finishes</li>
          </ul>
          <a href="#contact" class="btn-primary">Inquire / Order</a>
        </div>
      </div>
    </section>

    <% } %>

    <!-- GALLERY -->
    <section class="gallery-section" id="gallery">
      <h2 class="section-title">Gallery</h2>
      <% if (items.art.length) { %>
      <p class="section-sub">Tap any piece to see it up close.</p>
      <div class="tile-grid">
        <% items.art.forEach(function (it) { %>
        <a class="tile" href="/piece/<%= it.id %>/<%= slug(it.title) %>" data-piece="<%= it.id %>">
          <span class="tile-frame">
            <img src="<%= it.images[0].thumb_url %>" alt="<%= it.title %>" loading="lazy" decoding="async" />
          </span>
          <span class="tile-cap">
            <span class="tile-title"><%= it.title %></span>
            <% if (it.price) { %><span class="tile-price"><%= it.price %></span><% } %>
          </span>
        </a>
        <% }); %>
      </div>
      <% } else { %>
      <p class="section-sub">New pieces are being added soon &mdash; call or text to ask what's available.</p>
      <% } %>
    </section>

    <!-- CONTACT -->
    <section class="contact-section" id="contact">
      <h2 class="section-title">Contact James</h2>
      <div class="contact-cards">
        <a href="tel:7723418850" class="contact-card">
          <div class="contact-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.68A2 2 0 012 .82h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
            </svg>
          </div>
          <div>
            <div class="contact-label">Call or Text</div>
            <div class="contact-value">772-341-8850</div>
          </div>
        </a>
        <a href="mailto:jpowertahoe@aol.com" class="contact-card">
          <div class="contact-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <div>
            <div class="contact-label">Email</div>
            <div class="contact-value">jpowertahoe@aol.com</div>
          </div>
        </a>
        <a href="https://instagram.com/jpowercreations" target="_blank" rel="noopener" class="contact-card">
          <div class="contact-icon">
            <svg viewBox="0 0 24 24" role="img" aria-hidden="true">
              <defs>
                <linearGradient id="ig-grad-1" x1="0%" y1="100%" x2="100%" y2="0%">
                  <stop offset="0%"   stop-color="#FEDA75"/>
                  <stop offset="25%"  stop-color="#FA7E1E"/>
                  <stop offset="50%"  stop-color="#D62976"/>
                  <stop offset="75%"  stop-color="#962FBF"/>
                  <stop offset="100%" stop-color="#4F5BD5"/>
                </linearGradient>
              </defs>
              <path fill="url(#ig-grad-1)" d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z"/>
            </svg>
          </div>
          <div>
            <div class="contact-label">Instagram</div>
            <div class="contact-value">@jpowercreations</div>
          </div>
        </a>
      </div>
    </section>

    <footer class="site-footer">
      <p>&copy; 2025 Power Creations LLC &mdash; North Lake Tahoe &amp; Truckee, CA &nbsp;|&nbsp; 772-341-8850</p>
    </footer>

  </section>

  <!-- ===== VIEW 2: HOME PROJECTS ===== -->
  <section id="tab-home" class="tab-content">

    <header class="hero hero--services">
      <div class="hero-badge">
        <img src="/logo.png" alt="JPC Logo" class="hero-logo" />
      </div>
      <h1 class="hero-title">James Power<br><span>Home Services</span></h1>
      <p class="hero-sub">Reliable. Skilled. Local.</p>
      <p class="hero-location">Power Creations LLC &mdash; North Lake Tahoe &amp; Truckee, CA</p>
    </header>

    <section class="services-section">
      <h2 class="section-title">What I Do</h2>
      <div class="services-grid">
        <div class="service-card">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <h3>Carpentry</h3>
          <p>Rooms that feel finished. Custom framing, trim, built-ins, and repairs cut to fit your home exactly.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/>
            </svg>
          </div>
          <h3>Painting</h3>
          <p>Color that still looks sharp in five years. Careful prep, clean lines, inside or out.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="3"/><path d="M19.07 4.93l-1.41 1.41M5.34 18.66l-1.41 1.41M21 12h-2M5 12H3M19.07 19.07l-1.41-1.41M5.34 5.34L3.93 3.93M12 3V1m0 22v-2"/>
            </svg>
          </div>
          <h3>Handyman Repairs</h3>
          <p>The list on your fridge, finally done. Leaky faucets, sticking doors, and the small fixes that pile up.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M12 2a10 10 0 100 20A10 10 0 0012 2z" opacity="0.3"/>
              <path d="M8 14s1.5 2 4 2 4-2 4-2"/><path d="M9 9h.01M15 9h.01"/>
              <path d="M2 12s3-5 10-5 10 5 10 5"/>
            </svg>
          </div>
          <h3>Snow Removal</h3>
          <p>A safe driveway all winter. Walkways, decks, and rooftops cleared before ice dams do damage.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
            </svg>
          </div>
          <h3>Deck Repairs</h3>
          <p>A deck you trust again. Rotten boards replaced, structure made solid, surface refinished to last.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M5 12H3l9-9 9 9h-2v7a1 1 0 01-1 1h-4v-4h-4v4H6a1 1 0 01-1-1z"/>
            </svg>
          </div>
          <h3>Bathroom Updates</h3>
          <p>A bathroom you're glad to show guests. Tile, vanities, and fixtures updated without a full remodel.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><path d="M9 22V12h6v10"/>
            </svg>
          </div>
          <h3>Property Maintenance</h3>
          <p>One call instead of five. Ongoing upkeep for homes and rentals, handled before it becomes a problem.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/>
            </svg>
          </div>
          <h3>Home Improvement</h3>
          <p>The project you keep putting off, finished. Whatever your home needs, start to finish.</p>
        </div>
      </div>
    </section>

    <section class="why-section">
      <h2 class="section-title">Why James?</h2>
      <div class="why-list">
        <div class="why-item">
          <span class="why-check">&#10003;</span>
          <span>15+ years of hands-on trade experience</span>
        </div>
        <div class="why-item">
          <span class="why-check">&#10003;</span>
          <span>Local to North Lake Tahoe — fast response times</span>
        </div>
        <div class="why-item">
          <span class="why-check">&#10003;</span>
          <span>Honest, upfront estimates with no surprises</span>
        </div>
        <div class="why-item">
          <span class="why-check">&#10003;</span>
          <span>Quality craftsmanship guaranteed</span>
        </div>
      </div>
    </section>

    <!-- RECENT PROJECTS -->
    <% if (items.home.length) { %>
    <section class="gallery-section" id="projects">
      <h2 class="section-title">Recent Projects</h2>
      <p class="section-sub">Tap any job to see it up close.</p>
      <div class="tile-grid">
        <% items.home.forEach(function (it) { %>
        <a class="tile" href="/piece/<%= it.id %>/<%= slug(it.title) %>" data-piece="<%= it.id %>">
          <span class="tile-frame">
            <img src="<%= it.images[0].thumb_url %>" alt="<%= it.title %>" loading="lazy" decoding="async" />
          </span>
          <span class="tile-cap">
            <span class="tile-title"><%= it.title %></span>
            <% if (it.price) { %><span class="tile-price"><%= it.price %></span><% } %>
          </span>
        </a>
        <% }); %>
      </div>
    </section>
    <% } %>

    <!-- BEFORE & AFTER -->
    <section class="ba-section">
      <h2 class="section-title">Before &amp; After</h2>
      <p class="section-sub">Drag the handle to reveal the transformation.</p>
      <div class="ba-grid">

        <div class="ba-card">
          <div class="ba-slider" data-slot="1">
            <div class="ba-before">
              <img src="before-after/before1.jpeg" alt="Before" class="ba-img" />
              <span class="ba-tag ba-tag--before">Before</span>
            </div>
            <div class="ba-after">
              <img src="before-after/after1.jpeg" alt="After" class="ba-img" />
              <span class="ba-tag ba-tag--after">After</span>
            </div>
            <div class="ba-handle">
              <div class="ba-handle-line"></div>
              <div class="ba-handle-circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                  <polyline points="15 18 9 12 15 6"/>
                </svg>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </div>
              <div class="ba-handle-line"></div>
            </div>
          </div>
          <p class="ba-caption">Deck Project</p>
        </div>

        <div class="ba-card">
          <div class="ba-slider" data-slot="2">
            <div class="ba-before">
              <img src="before-after/before2.jpeg" alt="Before" class="ba-img" />
              <span class="ba-tag ba-tag--before">Before</span>
            </div>
            <div class="ba-after">
              <img src="before-after/after2.jpeg" alt="After" class="ba-img" />
              <span class="ba-tag ba-tag--after">After</span>
            </div>
            <div class="ba-handle">
              <div class="ba-handle-line"></div>
              <div class="ba-handle-circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                  <polyline points="15 18 9 12 15 6"/>
                </svg>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </div>
              <div class="ba-handle-line"></div>
            </div>
          </div>
          <p class="ba-caption">Yard Project</p>
        </div>

      </div>
    </section>

    <!-- SERVICE AREA -->
    <section class="area-section">
      <h2 class="section-title">Service Areas</h2>
      <p class="section-sub">Proudly serving North Lake Tahoe and the surrounding mountain communities.</p>
      <div class="area-grid">
        <span class="area-tag">Truckee</span>
        <span class="area-tag">Tahoe City</span>
        <span class="area-tag">Kings Beach</span>
        <span class="area-tag">Carnelian Bay</span>
        <span class="area-tag">Tahoe Vista</span>
        <span class="area-tag">Northstar</span>
        <span class="area-tag">Martis Camp</span>
        <span class="area-tag">Olympic Valley</span>
        <span class="area-tag">Homewood</span>
        <span class="area-tag">Tahoe Donner</span>
        <span class="area-tag">North Lake Tahoe</span>
        <span class="area-tag">Reno, NV</span>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="contact-section" id="contact-services">
      <h2 class="section-title">Contact James</h2>
      <div class="contact-cards">

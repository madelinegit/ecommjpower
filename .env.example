# Copy to .env for local development. On Railway, set these under
# your service's Variables tab. Never commit the filled-in .env.

# ── Database ───────────────────────────────────────────────────────────
# Railway: add a PostgreSQL database to the project, then reference it here
# as ${{Postgres.DATABASE_URL}} so it stays in sync automatically.
DATABASE_URL=postgresql://user:password@localhost:5432/jpower

# ── Admin login (https://jpowercreations.com/admin) ────────────────────
ADMIN_EMAIL=mgalldev@gmail.com

# bcrypt hash of the password — never the password itself.
# Generate with:  npm run hash-password "your-password-here"
ADMIN_PASSWORD_HASH=$2b$12$replace.this.with.the.generated.hash

# Signs the login cookie. Any long random string; changing it logs you out.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ── Photo storage ──────────────────────────────────────────────────────
# Uploaded photos must survive a redeploy. Railway wipes the container
# filesystem every deploy, so point UPLOADS_DIR at a Railway Volume:
#   Railway > your service > Settings > Volumes > New Volume
#   Mount path: /data   ->   UPLOADS_DIR=/data
UPLOADS_DIR=/data

# Optional: use Cloudflare R2 instead of a Volume. Leave blank to use the
# Volume. All five must be set for R2 to activate.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ── Optional ───────────────────────────────────────────────────────────
# PORT is set automatically by Railway.
PORT=3000
NODE_ENV=development
